---
import { getBooks } from '../lib/books';

interface Props {
  /** 表紙は cover__foot の中（罫線の下）。下層は自前の罫線の下にぶら下げる */
  variant?: 'cover' | 'page';
}
const { variant = 'page' } = Astro.props;

const books = await getBooks();

/**
 * いま開いている本。棚から抜いてある状態にする。
 *
 * ⚠️ **このサイトは build.format:'file'。** pathname は `/contents.html` の形で来る。
 * href 側は `/contents` なので、.html を落とさないと一生一致しない
 * （2026-08-29、これで判定が全ページ空振りした）。Base.astro の canonical と同じ処理。
 */
const clean = (p: string) =>
  p.replace(/index\.html$/, '').replace(/\.html$/, '').replace(/\/$/, '') || '/';
const here = clean(Astro.url.pathname);
const isHere = (href: string) => clean(href) === here;

/**
 * 面出しは「更新の新しい3冊」＋「いま開いている本」。
 * 表紙画像が無い本は面出しにできないので背表紙のまま。
 */
const FACE = 3;
---

<nav class:list={['shelf', `shelf--${variant}`]} aria-label="本棚">
  {books.map((b, i) => {
    const current = isHere(b.href);
    const face = (i < FACE || current) && !!b.thumb;
    return (
      <a
        class:list={['book', face && 'book--face', current && 'book--here']}
        href={b.href}
        aria-current={current ? 'page' : undefined}
      >
        {face ? <img class="book__cover" src={b.thumb} alt="" loading="lazy" />
              : <span class="book__ttl">{b.title}</span>}
        <span class="book__band">
          <b>{b.title}</b><i>{b.kind}</i>
          <em>{current ? 'いま開いている本' : b.note}</em>
        </span>
      </a>
    );
  })}
</nav>

<style>
  /* ══ 本棚 ═══════════════════════════════════════════
     ジャンルのメニューを持たない代わりに、これが移動手段になる。
     **本は罫線の下にぶら下げる**（本人・2026-08-29「これ、線の下のほうがいいわ。
     小さい本として並べとこう」）。棚板の上に立てる形はやめた。 */
  .shelf {
    --shelf-h: clamp(22px, 2.9vh, 30px);
    display: flex;
    align-items: flex-start;
    gap: 2px;
    height: var(--shelf-h);
    overflow: visible;
    position: relative;
    z-index: 4;
  }
  /* 表紙では cover__foot の中（＝罫線の下）に、CONTENTS の横で並ぶ */
  .shelf--cover { align-self: center; margin-right: auto; }
  .shelf--page {
    height: auto;
    margin: 3rem 0 0;
    padding-top: 10px;
    border-top: 2px solid var(--rule);
  }
  .shelf--page .book { height: var(--shelf-h); }

  .book {
    position: relative;
    display: block;
    width: 9px;
    height: 88%;
    background: var(--paper-2);
    border: 1px solid var(--ink-mid);
    border-top: 0;
    text-decoration: none;
    transition: height 150ms ease, background 150ms ease, transform 150ms ease;
  }
  .shelf--cover .book:nth-child(3n) { height: 94%; }
  .shelf--cover .book:nth-child(4n) { height: 80%; }

  .book--face {
    width: calc(var(--shelf-h) * 0.68);
    height: 100%;
    border-color: var(--ink);
    background: var(--paper);
  }
  .shelf--page .book--face { width: calc(var(--shelf-h) * 0.68); }

  .book__cover { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* 背表紙の題字。縦組みで、入らないぶんは自然に切れる */
  .book__ttl {
    display: block;
    writing-mode: vertical-rl;
    font-size: 8px;
    line-height: 9px;
    letter-spacing: .04em;
    color: var(--ink-mid);
    padding: 2px 0 0;
    height: 100%;
    overflow: hidden;
    white-space: nowrap;
  }

  .book:hover, .book:focus-visible { height: 100%; background: var(--accent); }
  .book:hover .book__ttl { color: var(--paper); }
  .book--face:hover { background: var(--paper); }

  /* いま開いている本は、棚から少し抜いてある */
  .book--here {
    transform: translateY(6px);
    border-color: var(--accent);
    border-top: 2px solid var(--accent);
  }
  .book--here:not(.book--face) { background: var(--accent); }
  .book--here:not(.book--face) .book__ttl { color: var(--paper); }

  /* ホバーで出る帯 */
  .book__band {
    position: absolute;
    left: 0;
    /* 本は罫線の下にぶら下がる＝画面の最下部。**帯を下へ出すと切れる**ので必ず上へ */
    bottom: calc(100% + 8px);
    display: none;
    width: max-content;
    max-width: min(46vw, 420px);
    padding: .45em .7em;
    background: var(--ink);
    color: var(--paper);
    font-size: .74rem;
    line-height: 1.5;
    z-index: 5;
  }
  .book:hover .book__band, .book:focus-visible .book__band { display: block; }
  .book__band b { font-weight: 700; }
  .book__band i {
    font-style: normal;
    margin-left: .6em;
    padding: .05em .45em;
    border: 1px solid currentColor;
    font-size: .82em;
    opacity: .75;
  }
  .book__band em { display: block; font-style: normal; opacity: .72; }
  /* 右端に近い本は帯が画面外へ出るので、右寄せに切り替える */
  .book:nth-last-child(-n + 3) .book__band { left: auto; right: 0; }
</style>
