---
/** 作品・シナリオ共通の誌面。**演出より可読性を優先する**（仕様書5章） */
interface Props {
  data: {
    title: string;
    catch: string;
    date: Date;
    status: 'published' | 'making' | 'ended';
    priceType: 'free' | 'paid' | 'donation' | 'unknown';
    heroImage: string;
    description: string;
    links: { label: string; url: string }[];
    tags: string[];
  };
  feature?: string;
}
const { data, feature } = Astro.props;

const STATUS = { published: '公開中', making: '制作中', ended: '公開終了' } as const;
const PRICE = { free: '無料', paid: '有料', donation: '無料＋支援版', unknown: '—' } as const;
const ymd = `${data.date.getFullYear()}.${String(data.date.getMonth() + 1).padStart(2, '0')}.${String(data.date.getDate()).padStart(2, '0')}`;
---

<article class="wrap measure">
  {feature && <p class="feature">{feature}</p>}
  <h1 class="ttl">{data.title}</h1>
  <p class="catch">{data.catch}</p>

  <img class="hero" src={data.heroImage} alt={`${data.title} のメインビジュアル`} width="1600" height="900" loading="eager" />

  <dl class="meta">
    <div><dt>公開</dt><dd>{ymd}</dd></div>
    <div><dt>状態</dt><dd>{STATUS[data.status]}</dd></div>
    <div><dt>価格</dt><dd>{PRICE[data.priceType]}</dd></div>
    {data.tags.length > 0 && <div><dt>タグ</dt><dd>{data.tags.join(' / ')}</dd></div>}
  </dl>

  {data.links.length > 0 && (
    <p class="links">
      {data.links.map((l) => (
        <a class="link" href={l.url} rel="noopener">{l.label} <span aria-hidden="true">↗</span></a>
      ))}
    </p>
  )}

  <div class="prose"><slot /></div>

  <p class="back"><a class="link" href="/contents">← 目次へ戻る</a></p>
</article>

<style>
  .feature {
    font-family: var(--font-en);
    font-size: 11px; letter-spacing: .24em; color: var(--accent);
    font-weight: 700; margin: 2.2rem 0 .6rem;
  }
  .ttl {
    font-size: clamp(1.8rem, 4.4vw, 3.2rem);
    line-height: 1.15; letter-spacing: -.03em; margin: 0 0 .3em;
  }
  .catch {
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 700; color: var(--ink-mid); margin: 0 0 1.6rem;
  }
  /* 元画像の縦横比がまちまちなので、枠側で 16:9 に切る */
  .hero {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--rule);
    background: var(--paper-2);
  }
  .meta {
    display: flex; flex-wrap: wrap; gap: 0 2.4rem;
    margin: 1.4rem 0 1.6rem; padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--rule);
    font-size: .92rem;
  }
  .meta div { display: flex; gap: .7em; }
  .meta dt { color: var(--ink-mid); margin: 0; }
  .meta dd { margin: 0; font-weight: 700; }
  .links { display: flex; flex-wrap: wrap; gap: 1.4rem; margin: 0 0 2rem; font-weight: 700; }
  .back { margin-top: 3rem; padding-top: 1.2rem; border-top: 1px solid var(--rule); }
</style>
