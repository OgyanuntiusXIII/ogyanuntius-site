---
/** 作品・シナリオ共通の誌面。**演出より可読性を優先する**（仕様書5章） */
interface Props {
  data: {
    title: string;
    catch: string;
    date: Date;
    status: 'published' | 'making' | 'ended';
    priceType: 'free' | 'paid' | 'donation' | 'unknown';
    heroImage: string;
    description: string;
    links: { label: string; url: string }[];
    tags: string[];
    youtubeId?: string;
  };
  feature?: string;
}
const { data, feature } = Astro.props;

const STATUS = { published: '公開中', making: '制作中', ended: '公開終了' } as const;
const PRICE = { free: '無料', paid: '有料', donation: '無料＋支援版', unknown: '—' } as const;
const ymd = `${data.date.getFullYear()}.${String(data.date.getMonth() + 1).padStart(2, '0')}.${String(data.date.getDate()).padStart(2, '0')}`;
---

<article class="wrap measure">
  {feature && <p class="feature">{feature}</p>}
  <h1 class="ttl">{data.title}</h1>
  <p class="catch">{data.catch}</p>

  {data.youtubeId ? (
    /* 押されるまでYouTubeを読み込まない。ポスターは手元の画像なので外部通信ゼロ */
    <div class="hero hero--video" data-yt={data.youtubeId}>
      <img src={data.heroImage} alt={`${data.title} のメインビジュアル`} width="1600" height="900" loading="eager" />
      <button type="button" class="hero__play">
        <span class="hero__triangle" aria-hidden="true"></span>
        <span class="hero__label">紹介ムービーを再生</span>
      </button>
    </div>
  ) : (
    <img class="hero" src={data.heroImage} alt={`${data.title} のメインビジュアル`} width="1600" height="900" loading="eager" />
  )}

  <dl class="meta">
    <div><dt>公開</dt><dd>{ymd}</dd></div>
    <div><dt>状態</dt><dd>{STATUS[data.status]}</dd></div>
    <div><dt>価格</dt><dd>{PRICE[data.priceType]}</dd></div>
    {data.tags.length > 0 && <div><dt>タグ</dt><dd>{data.tags.join(' / ')}</dd></div>}
  </dl>

  {data.links.length > 0 && (
    <p class="links">
      {data.links.map((l) => (
        <a class="link" href={l.url} rel="noopener">{l.label} <span aria-hidden="true">↗</span></a>
      ))}
    </p>
  )}

  <div class="prose"><slot /></div>

  <p class="back"><a class="link" href="/contents">← 目次へ戻る</a></p>
</article>

<script>
  // 押されて初めて YouTube を読み込む。それまで外部通信は一切ない。
  // astro:page-load は View Transitions のあとにも走る
  const wire = () => {
    document.querySelectorAll<HTMLElement>('.hero--video').forEach((box) => {
      const btn = box.querySelector<HTMLButtonElement>('.hero__play');
      if (!btn || btn.dataset.wired) return;
      btn.dataset.wired = '1';
      btn.addEventListener('click', () => {
        const id = box.dataset.yt;
        if (!id) return;
        const f = document.createElement('iframe');
        // nocookie 版。再生するまでCookieを置かない
        // playsinline はスマホで全画面に飛ばされないため
        f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1`;
        f.title = '紹介ムービー';
        f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        f.allowFullscreen = true;
        box.appendChild(f);
        btn.remove();
      });
    });
  };
  wire();
  document.addEventListener('astro:page-load', wire);
</script>

<style>
  .feature {
    font-family: var(--font-en);
    font-size: 11px; letter-spacing: .24em; color: var(--accent);
    font-weight: 700; margin: 2.2rem 0 .6rem;
  }
  .ttl {
    font-size: clamp(1.8rem, 4.4vw, 3.2rem);
    line-height: 1.15; letter-spacing: -.03em; margin: 0 0 .3em;
  }
  .catch {
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 700; color: var(--ink-mid); margin: 0 0 1.6rem;
  }
  /* 元画像の縦横比がまちまちなので、枠側で 16:9 に切る */
  .hero {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--rule);
    background: var(--paper-2);
  }

  /* --- 紹介ムービー -------------------------------------------
     クリックされるまで iframe を作らない。それまでは手元の画像だけ。 */
  .hero--video { position: relative; overflow: hidden; padding: 0; }
  .hero--video > img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* iframe は**JSで後から作る**ので Astro のスコープ属性が付かない。
     :global() を付けないとこのCSSは一切当たらない（実測で304x154の素のiframeになった） */
  .hero--video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .hero__play {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: .9em;
    width: 100%;
    background: rgba(16, 16, 16, .34);
    border: 0;
    cursor: pointer;
    color: #fff;
    font: inherit;
    transition: background 160ms ease;
  }
  .hero__play:hover { background: rgba(16, 16, 16, .5); }
  .hero__triangle {
    width: clamp(46px, 7vw, 72px);
    height: clamp(46px, 7vw, 72px);
    border-radius: 50%;
    background: var(--accent);
    position: relative;
    transition: transform 160ms ease;
  }
  .hero__triangle::after {
    content: '';
    position: absolute;
    top: 50%; left: 54%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: .55em 0 .55em .95em;
    border-color: transparent transparent transparent #fff;
    font-size: clamp(16px, 2.4vw, 24px);
  }
  .hero__play:hover .hero__triangle { transform: scale(1.08); }
  .hero__label {
    font-size: clamp(.78rem, 1.2vw, .92rem);
    font-weight: 700;
    letter-spacing: .1em;
    text-shadow: 0 1px 3px rgba(0, 0, 0, .6);
  }
  .meta {
    display: flex; flex-wrap: wrap; gap: 0 2.4rem;
    margin: 1.4rem 0 1.6rem; padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--rule);
    font-size: .92rem;
  }
  .meta div { display: flex; gap: .7em; }
  .meta dt { color: var(--ink-mid); margin: 0; }
  .meta dd { margin: 0; font-weight: 700; }
  .links { display: flex; flex-wrap: wrap; gap: 1.4rem; margin: 0 0 2rem; font-weight: 700; }
  .back { margin-top: 3rem; padding-top: 1.2rem; border-top: 1px solid var(--rule); }
</style>
