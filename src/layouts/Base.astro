---
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../data/site';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** 表紙だけ true。ヘッダーとフッターを出さない */
  cover?: boolean;
  /** About ページだけ true。ProfilePage / Person を出す */
  profile?: boolean;
  /** 記事など、ページ側で組み立てた構造化データ */
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = SITE.description,
  ogImage = SITE.ogImage,
  cover = false,
  profile = false,
  structuredData: suppliedStructuredData,
} = Astro.props;

const pageTitle = cover ? SITE.title : `${title}｜${SITE.title}`;
// build.format:'file' だと pathname が /about.html になる。
// 公開URLは /about なので、canonical と og:url からは .html を落とす
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '') || '/';
const canonical = new URL(cleanPath, Astro.site ?? SITE.origin).href;
const ogUrl = new URL(ogImage, Astro.site ?? SITE.origin).href;

const websiteId = new URL('/#website', SITE.origin).href;
const personId = new URL('/about#person', SITE.origin).href;
const defaultStructuredData = cover
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      '@id': websiteId,
      url: `${SITE.origin}/`,
      name: SITE.title,
      alternateName: [SITE.titleEn, ...SITE.aliases],
      description: SITE.description,
      inLanguage: 'ja',
    }
  : profile
    ? {
        '@context': 'https://schema.org',
        '@type': 'ProfilePage',
        '@id': `${canonical}#profile`,
        url: canonical,
        name: `オギャヌンティウス十三世とは`,
        isPartOf: { '@id': websiteId },
        inLanguage: 'ja',
        mainEntity: {
          '@type': 'Person',
          '@id': personId,
          name: SITE.title,
          alternateName: [SITE.titleEn, ...SITE.aliases],
          url: canonical,
          description: SITE.creatorDescription,
          jobTitle: 'クリエイター',
          image: new URL('/images/about/icon-cory.webp', SITE.origin).href,
          sameAs: SITE.sameAs,
          knowsAbout: ['ゲーム制作', 'アプリ開発', 'TRPGシナリオ制作', '動画制作'],
        },
      }
    : null;

const structuredData = suppliedStructuredData ?? defaultStructuredData;

const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : null;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* スマホのブラウザの枠の色。中身は下のスクリプトが今の明暗に合わせて書き換える */}
    <meta name="theme-color" content="#ffffff" />

    <script is:inline>
      /* 昼夜の切り替え。**必ず head に、描画より前に置く。**
         body の後ろへ置くと、夜を選んでいる人に**一瞬だけ白い誌面が見える**（フラッシュ）。

         ⚠️ ClientRouter は遷移のたびに <html> の属性を「移動先のページのもの」で
            上書きする。ビルド時のHTMLに data-theme は入っていないので、塗り直さないと
            **目次へ移った瞬間に昼へ戻る。** astro:after-swap は差し替え直後・
            描画前に走るので、そこで塗り直している。

         何も押していない人には data-theme を付けない。そのときはCSS側の
         @media (prefers-color-scheme) が効いて、OSの設定にそのまま従う。 */
      (() => {
        const KEY = 'ogyanun.theme';
        const root = document.documentElement;
        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        const read = () => { try { return localStorage.getItem(KEY); } catch (e) { return null; } };

        function paint() {
          const saved = read();
          if (saved === 'dark' || saved === 'light') root.setAttribute('data-theme', saved);
          else root.removeAttribute('data-theme');
          const dark = saved ? saved === 'dark' : mq.matches;
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#121211' : '#ffffff');
        }

        paint();
        document.addEventListener('astro:after-swap', paint);
        /* 何も押していない人が、OS側で夜に切り替えたとき */
        mq.addEventListener('change', paint);

        /* ボタンは遷移のたびに作り直される。だから document で受ける
           （本文側の委譲と同じ理由。個別の要素へ addEventListener しない） */
        document.addEventListener('click', (e) => {
          const t = e.target;
          if (!(t instanceof Element) || !t.closest('[data-theme-toggle]')) return;
          const now = root.getAttribute('data-theme') || (mq.matches ? 'dark' : 'light');
          try { localStorage.setItem(KEY, now === 'dark' ? 'light' : 'dark'); } catch (err) {}
          paint();
        });
      })();
    </script>

    {/* 誌名にだけ使うディドー系。**ラテン部分集合のみで数十KB。**
        日本語ウェブフォント（数MB級）は入れない、という判断は変えていない */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400..600&display=swap"
    />

    <meta property="og:type" content={cover ? 'website' : 'article'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />

    {structuredDataJson && <script is:inline type="application/ld+json" set:html={structuredDataJson} />}

    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">本文へスキップ</a>

    {!cover && (
      <header class="rail">
        <a href="/" style="text-decoration:none">{SITE.titleEn}</a>
        <span class="rail__right">
          <nav aria-label="誌面">
            <a href="/contents" class="link">CONTENTS</a>
            <span aria-hidden="true"> / </span>
            <a href="/about" class="link">ABOUT</a>
          </nav>
          <ThemeToggle />
        </span>
      </header>
    )}

    <main id="main">
      <slot />
    </main>

    {!cover && (
      <footer class="rail" style="border-bottom:none;border-top:1px solid var(--rule)">
        <span>{SITE.title} — VOL.01</span>
        <span>
          <a href="/contents" class="link">創刊号 →</a>
          <span aria-hidden="true"> / </span>
          <a href="/sessions" class="link">卓報告 →</a>
          <span aria-hidden="true"> / </span>
          <a href="/press" class="link">プレスキット →</a>
          <span aria-hidden="true"> / </span>
          <a href="/" class="link">表紙へ戻る</a>
        </span>
      </footer>
    )}

    {/*
      🔴 **ポップアップの開閉は、必ずここ（レイアウト）に置く。**

      このサイトは <ClientRouter /> を使っている。Astroの仕様で
      **モジュールスクリプトはブラウザが1度しか実行しない**ため、
      個別ページの <script> はクライアント側遷移で入ったときに走らない。
      実際 2026-08-29、/sessions のカードが「押しても無反応」になった
      （URL直打ちなら動くのに、目次から辿ると動かない、という出方をする）。

      レイアウトなら最初の実読み込みで必ず1度走り、document は遷移をまたいで
      生き残るので、以後どのページのどのポップでも効く。
      **ページ側で要素へ直接 addEventListener しないこと。**
    */}
    <script>
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement | null;
        if (!t) return;

        const opener = t.closest('[data-open]');
        if (opener) {
          const id = opener.getAttribute('data-open');
          const d = id ? document.getElementById(id) : null;
          if (d instanceof HTMLDialogElement && !d.open) d.showModal();
          return;
        }

        /* 外側を押しても閉じる。dialog の当たり判定は箱の外まで及ぶので target で見る */
        if (t instanceof HTMLDialogElement && t.hasAttribute('data-pop')) t.close();
      });
    </script>
    <script is:inline>
      /* 公式サイトTOP（表紙）の閲覧数。
         ⚠️ **1人1日1回しか数えない。** 更新するたびに増えると数字が実態より膨らむので、
            ブラウザに「最後に数えた日」を持たせて、同じ日の2回目以降は数えない
            （表示は毎回する）。日付は**日本時間**でサーバ側と揃える。
            シークレットウィンドウ・別ブラウザ・履歴削除は別人として数える。
            そこはIPを見れば潰せるが、個人サイトの数字に個人情報を持ち出すのは
            釣り合わないので採らなかった（本人と相談のうえ・2026-08-30）。
         ⚠️ このサイトは ClientRouter を使っているので、
            インラインscriptは**最初の1回しか走らない**。astro:page-load を併用する
            （プレイ回数のほうで実際にそれを踏んだ）。
         D1が繋がっていないときは204が返るので、その場合は何も出さない。 */
      (() => {
        const KEY = 'ogyanun.viewed';
        /** 日本時間の YYYY-MM-DD。サーバ側の切り方と揃える */
        function jstDay(){
          return new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
        }
        function show(d){
          const box = document.getElementById('viewBox');
          const t = document.getElementById('viewToday');
          const a = document.getElementById('viewTotal');
          if (!box || !t || !a || !d || typeof d.total !== 'number') return;
          t.textContent = d.today.toLocaleString('ja-JP');
          a.textContent = d.total.toLocaleString('ja-JP');
          box.hidden = false;
        }
        function tick(){
          if (location.pathname !== '/' && location.pathname !== '/index.html') return;
          if (!document.getElementById('viewBox')) return;
          const today = jstDay();
          let seen = null;
          try { seen = localStorage.getItem(KEY); } catch (e) {}
          // 今日まだ数えていなければ1増やす。数えていれば読むだけ
          const first = seen !== today;
          fetch('/api/views', first ? { method: 'POST' } : {})
            .then((r) => (r.ok && r.status !== 204 ? r.json() : null))
            .then((d) => {
              if (!d) return;
              if (first) { try { localStorage.setItem(KEY, today); } catch (e) {} }
              show(d);
            })
            .catch(() => {});
        }
        tick();
        document.addEventListener('astro:page-load', tick);
      })();
    </script>
  </body>
</html>
