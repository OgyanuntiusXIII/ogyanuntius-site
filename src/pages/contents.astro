---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { buildNewsLinker } from '../lib/newsLink';
import { LINKS, SITE, CONTACT, CREDITS } from '../data/site';

const issues = await getCollection('issues');
const issue = issues.find((i) => i.data.current) ?? issues[0];

const works = await getCollection('works');
const scenarios = await getCollection('scenarios');
const nowmaking = (await getCollection('nowmaking')).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news')).sort((a, b) => +b.data.date - +a.data.date);
/* url が無い行は素の文字のままで、押せなかった。ref から作品ページへ繋ぐ */
const newsLink = await buildNewsLinker();

const features = [
  ...works.map((w) => ({ ...w.data, href: `/works/${w.id}` })),
  ...scenarios.map((s) => ({ ...s.data, href: `/scenario/${s.id}` })),
].sort((a, b) => +a.date - +b.date);

const md = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const shownLinks = LINKS.filter((l) => l.url !== '');
---
<Base title="目次" description={`${SITE.title} ${issue?.data.vol} の目次。`}>
  <div class="wrap measure">
    <p class="kicker">{issue?.data.vol}　{issue?.data.label}</p>
    <h1 class="h1">CONTENTS</h1>

    <ol class="toc">
      {features.map((f, i) => (
        <li class="toc__item">
          <a class="toc__link" href={f.href}>
            <span class="toc__no">{String(i + 1).padStart(2, '0')}</span>
            <span class="toc__body">
              <span class="toc__ttl">{f.title}</span>
              <span class="toc__catch">{f.catch}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>

    <h2 class="h2">NOW MAKING</h2>
    <ul class="plain">
      {nowmaking.map((n) => (
        <li>
          {n.data.ref
            ? <a class="link" href={`/works/${n.data.ref}`}><strong>{n.data.title}</strong></a>
            : <strong>{n.data.title}</strong>} — {n.data.catch}
          {n.data.progress && <span class="dim">（{n.data.progress}・{md(n.data.updated)}）</span>}
        </li>
      ))}
    </ul>

    <h2 class="h2">NEWS ／ 今月の制作物</h2>
    <ul class="plain">
      {news.map((n) => {
        const link = newsLink(n);
        return (
          <li>
            <span class="dim">{md(n.data.date)}</span>{' '}
            <a class="link" href={link.href} rel={link.external ? 'noopener' : undefined}>
              {n.data.title}{link.external && <> <span aria-hidden="true">↗</span></>}
            </a>
          </li>
        );
      })}
    </ul>

    <h2 class="h2">LINKS</h2>
    {shownLinks.length > 0 ? (
      <ul class="plain">
        {shownLinks.map((l) => (
          <li><a class="link" href={l.url} rel="me noopener">{l.label} <span aria-hidden="true">↗</span></a></li>
        ))}
      </ul>
    ) : (
      <p class="dim">準備中。</p>
    )}

    <h2 class="h2"><a class="h2__link" href="/sessions">SESSION LOG ／ 卓の記録</a></h2>

    <h2 class="h2">制作の裏側</h2>
    <ul class="plain">
      <li><a class="link" href="/blog">開発メモ・制作記事の一覧へ</a></li>
    </ul>

    <h2 class="h2">CONTACT</h2>
    <ul class="plain">
      <li><a class="link" href={CONTACT.x} rel="me noopener">X {CONTACT.xHandle} <span aria-hidden="true">↗</span></a></li>
    </ul>

    <h2 class="h2">奥付</h2>
    <pre class="colophon">{issue?.data.colophon.join('\n')}</pre>
    <p class="credits"><span class="credits__label">{CREDITS.label}</span>{CREDITS.text}</p>
  </div>
</Base>

<style>
  .kicker { font-family: var(--font-en); font-size: 11px; letter-spacing: .24em; color: var(--accent); font-weight: 700; margin: 2.2rem 0 .3rem; }
  .h1 { font-family: var(--font-en); font-size: clamp(2.4rem, 8vw, 5rem); letter-spacing: -.02em; margin: 0 0 2rem; }
  .h2 { font-family: var(--font-en); font-size: 1rem; letter-spacing: .2em; margin: 3.2rem 0 1rem; padding-bottom: .4em; border-bottom: 2px solid var(--rule); }
  /* 見出しそのものがリンクになる節。下線を出さず、見出しの見た目を保つ */
  .h2__link { color: inherit; text-decoration: none; }
  .h2__link:hover, .h2__link:focus-visible { color: var(--accent); }
  .h2__link::after { content: " →"; font-size: .85em; color: var(--accent); }
  .toc { list-style: none; margin: 0; padding: 0; }
  .toc__item { border-top: 1px solid var(--rule); }
  .toc__item:last-child { border-bottom: 1px solid var(--rule); }
  .toc__link { display: flex; gap: clamp(12px, 3vw, 32px); align-items: baseline; padding: 1.1rem 0; text-decoration: none; }
  .toc__link:hover .toc__ttl { text-decoration: underline; }
  .toc__no { font-family: var(--font-en); font-size: clamp(1.6rem, 5vw, 2.8rem); font-weight: 700; font-style: italic; color: var(--accent); line-height: 1; min-width: 2.2ch; }
  .toc__body { display: block; }
  .toc__ttl { display: block; font-size: clamp(1.1rem, 2.4vw, 1.6rem); font-weight: 700; line-height: 1.3; }
  .toc__catch { display: block; color: var(--ink-mid); font-size: .92rem; }
  .plain { list-style: none; margin: 0; padding: 0; }
  .plain li { padding: .5rem 0; border-bottom: 1px solid var(--hair-rule); }
  .dim { color: var(--ink-mid); font-size: .88rem; }
  .colophon { font-family: var(--font-jp); background: var(--paper-2); border: 1px solid var(--rule); padding: 1.2rem; line-height: 1.9; white-space: pre-wrap; }
  .credits { margin: .9rem 0 0; font-size: .78rem; line-height: 1.7; color: var(--ink-mid); }
  .credits__label {
    display: inline-block; margin-right: .7em; padding: .05em .5em;
    border: 1px solid currentColor; font-size: .92em; letter-spacing: .08em;
  }
</style>
