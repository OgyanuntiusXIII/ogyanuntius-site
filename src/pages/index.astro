---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const issues = await getCollection('issues');
const issue = issues.find((i) => i.data.current) ?? issues[0];
if (!issue) throw new Error('src/content/issues/ に号が1つも無い');

const works = await getCollection('works');
const scenarios = await getCollection('scenarios');

type Resolved = { catch: string; href: string; badge?: string; no?: number };

const index = new Map<string, { catch: string; href: string }>();
for (const w of works) index.set(w.id, { catch: w.data.catch, href: `/works/${w.id}` });
for (const s of scenarios) index.set(s.id, { catch: s.data.catch, href: `/scenario/${s.id}` });

/** ref を解決する。見つからなければビルドを落とす（壊れたまま本番へ出さない） */
function resolve(h: (typeof issue.data.headlines)[number]): Resolved {
  if (h.collection === 'page') {
    return { catch: h.catch ?? h.ref, href: h.ref, badge: h.badge, no: h.no };
  }
  const found = index.get(h.ref);
  if (!found) {
    throw new Error(
      `vol01.md の headlines に未知の ref: "${h.ref}"。` +
        `src/content/${h.collection}/${h.ref}.md が要る`
    );
  }
  return { catch: h.catch ?? found.catch, href: found.href, badge: h.badge, no: h.no };
}

const slot = (name: string) =>
  issue.data.headlines.filter((h) => h.slot === name).map(resolve);

const lead = slot('lead');
const upper = slot('upper');
const side = slot('side');
const lower = slot('lower');
const strip = slot('strip');

const issued = issue.data.published;
const ym = `${issued.getFullYear()}.${String(issued.getMonth() + 1).padStart(2, '0')}`;
---

<Base title="表紙" cover>
  <div class="cover">
    <div class="cover__rail">
      <span>{issue.data.vol}　{issue.data.label}　{ym}</span>
      <span class="cover__price">定価 ¥0</span>
    </div>

    <h1 class="cover__title">
      <span class="cover__title-jp">オギャヌンティウス十三世</span>
      <span class="cover__title-en">OGYANUNTIUS XIII</span>
    </h1>

    <div class="cover__body">
      <div class="cover__left">
        <p class="cover__theme">{issue.data.theme}</p>

        {lead.map((h) => (
          <a class="cover__lead" href={h.href}>
            {h.no && <i class="no">{String(h.no).padStart(2, '0')}</i>}
            {h.badge && <span class="label">{h.badge}</span>}
            <span class="cover__lead-text">{h.catch}</span>
          </a>
        ))}

        {lower.map((h) => (
          <a class="cover__small" href={h.href}>
            <span aria-hidden="true">▶</span> {h.catch}
          </a>
        ))}
      </div>

      <figure class="cover__visual">
        {/* 中央に置く一冊。雑誌らしさはここで作る。周りの誌面レイアウトは触らない */}
        <div class={`mag mag--${issue.data.coverInk}`}>
          <img
            src={issue.data.mainVisual}
            alt={issue.data.mainVisualAlt}
            width="1200"
            height="1500"
            fetchpriority="high"
            style={`object-position:${issue.data.mainVisualFocus}`}
          />
          {/* 誌面側に同じ情報があるので、読み上げでは飛ばす（仕様書20章） */}
          <div class="mag__dress" aria-hidden="true">
            <div class="mag__top">
              <span class="mag__vol">{issue.data.vol}</span>
              <span class="mag__label">{issue.data.label}</span>
            </div>
            <p class="mag__masthead">オギャヌンティウス十三世</p>
            <div class="mag__bottom">
              <span class="mag__price">¥0</span>
              <span class="mag__barcode"></span>
            </div>
          </div>
        </div>
      </figure>

      <div class="cover__right">
        {[...upper, ...side].map((h) => (
          <a class="cover__mid" href={h.href}>
            {h.no && <i class="no">{String(h.no).padStart(2, '0')}</i>}
            {h.badge && <span class="label">{h.badge}</span>}
            <span>{h.catch}</span>
          </a>
        ))}

        <ul class="cover__strips">
          {issue.data.strips.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>

    <div class="cover__foot">
      <a href="/contents" class="cover__contents">
        CONTENTS <span aria-hidden="true">→</span>
      </a>
      {strip.map((h) => (
        <a class="cover__small" href={h.href}>
          <span aria-hidden="true">▶</span> {h.catch}
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  /* 表紙だけはインパクト最優先（仕様書5章）。ここ以外へこの書き方を持ち出さない。 */
  .cover {
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    padding: 0 var(--gut) calc(var(--gut) * 0.6);
    gap: clamp(10px, 1.6vw, 22px);
  }

  .cover__rail {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-en);
    font-size: clamp(10px, 1.1vw, 12px);
    letter-spacing: 0.2em;
    padding: 12px 0 8px;
    border-bottom: 2px solid var(--rule);
  }
  .cover__price { color: var(--accent); font-weight: 700; }

  .cover__title { margin: 0; }
  .cover__title-jp {
    display: block;
    font-size: clamp(1.9rem, 7.8vw, 7.2rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }
  .cover__title-en {
    display: block;
    font-family: var(--font-en);
    font-size: clamp(9px, 1.25vw, 15px);
    font-weight: 400;
    letter-spacing: 0.52em;
    padding-top: 0.5em;
  }

  .cover__body {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2.4vw, 34px);
    align-items: start;
    min-height: 0;
  }

  .cover__theme {
    margin: 0 0 0.5em;
    font-size: clamp(2rem, 6.4vw, 4.6rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .cover__lead {
    display: block;
    text-decoration: none;
    font-size: clamp(1.05rem, 2.1vw, 1.7rem);
    font-weight: 700;
    line-height: 1.35;
    border-top: 1px solid var(--rule);
    padding-top: 0.5em;
    margin-bottom: 0.9em;
  }
  .cover__lead-text { display: inline; }
  .cover__lead:hover .cover__lead-text,
  .cover__mid:hover span:last-child { text-decoration: underline; }

  .cover__mid {
    display: block;
    text-decoration: none;
    font-size: clamp(0.95rem, 1.35vw, 1.15rem);
    font-weight: 700;
    line-height: 1.45;
    border-top: 1px solid var(--rule);
    padding: 0.5em 0 0.9em;
  }

  .cover__small {
    display: inline-block;
    text-decoration: none;
    font-size: clamp(0.8rem, 1vw, 0.9rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    margin-right: 1.4em;
  }
  .cover__small:hover { color: var(--accent); }

  /* --- 中央の一冊 -------------------------------------------
     寸法は cqw（この一冊の幅基準）。誌面側の vw とは独立しているので、
     ここを触っても表紙のレイアウトは動かない。 */
  .cover__visual {
    margin: 0;
    min-height: 0;
    display: flex;
    justify-content: center;
  }

  .mag {
    container-type: inline-size;
    position: relative;
    width: 100%;
    aspect-ratio: var(--mag-ratio);
    overflow: hidden;
    background: var(--paper-2);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, .55),
      0 2px 0 rgba(0, 0, 0, .10),
      0 22px 44px -16px rgba(0, 0, 0, .45);
  }

  .mag > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 画像の明暗に関わらず文字が読めるよう、上下だけ薄く沈める */
  .mag__dress {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 4.5cqw;
    color: var(--mag-ink);
    text-shadow: var(--mag-shadow);
  }
  .mag__dress::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--mag-scrim);
    pointer-events: none;
  }
  .mag__dress > * { position: relative; }

  .mag--dark { --mag-ink: #101010; --mag-shadow: 0 1px 2px rgba(255,255,255,.5);
    --mag-scrim: linear-gradient(180deg, rgba(255,255,255,.72), rgba(255,255,255,0) 34%,
                 rgba(255,255,255,0) 74%, rgba(255,255,255,.66)); }
  .mag--light { --mag-ink: #ffffff; --mag-shadow: 0 1px 3px rgba(0,0,0,.55);
    --mag-scrim: linear-gradient(180deg, rgba(0,0,0,.5), rgba(0,0,0,0) 34%,
                 rgba(0,0,0,0) 74%, rgba(0,0,0,.45)); }

  .mag__top {
    display: flex;
    align-items: baseline;
    gap: .9em;
    font-family: var(--font-en);
    font-size: 2.9cqw;
    font-weight: 700;
    letter-spacing: .18em;
  }
  .mag__label { font-family: var(--font-jp); letter-spacing: .12em; }

  .mag__masthead {
    margin: .34em 0 0;
    font-size: 8.8cqw;
    font-weight: 800;
    line-height: .96;
    letter-spacing: -.05em;
  }

  .mag__bottom {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1em;
    font-family: var(--font-en);
    font-size: 3cqw;
    font-weight: 700;
    letter-spacing: .1em;
  }

  /* バーコード。画像ではなく背景の縞で描く（1バイトも増やさない） */
  .mag__barcode {
    width: 26cqw;
    height: 7.5cqw;
    background-image: repeating-linear-gradient(90deg,
      currentColor 0 1.5%, transparent 1.5% 3%,
      currentColor 3% 4%,   transparent 4% 6.5%,
      currentColor 6.5% 8.5%, transparent 8.5% 10%);
    opacity: .85;
  }

  .cover__strips {
    list-style: none;
    margin: 0.6em 0 0;
    padding: 0;
    font-size: clamp(0.72rem, 0.92vw, 0.82rem);
    line-height: 1.7;
    color: var(--ink-mid);
  }
  .cover__strips li::before { content: '▸ '; color: var(--accent); }

  .cover__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 1.2em;
    border-top: 2px solid var(--rule);
    padding-top: 10px;
  }
  .cover__contents {
    font-family: var(--font-en);
    font-size: clamp(0.8rem, 1.1vw, 1rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-decoration: none;
    margin-right: auto;
  }
  .cover__contents:hover { color: var(--accent); }

  /* 見開きを感じさせるのはPCだけ（仕様書19章） */
  @media (min-width: 900px) {
    .cover { overflow: hidden; }
    .cover__title-jp { white-space: nowrap; }
    .cover__body {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.15fr) minmax(0, 0.8fr);
      align-items: stretch;
    }
    .cover__left { display: flex; flex-direction: column; justify-content: flex-start; }
    .cover__visual { height: 100%; align-items: center; }
    .mag { width: auto; height: 100%; max-width: 100%; }
  }
</style>
