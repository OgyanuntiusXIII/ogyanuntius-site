---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const issues = await getCollection('issues');
const issue = issues.find((i) => i.data.current) ?? issues[0];
if (!issue) throw new Error('src/content/issues/ に号が1つも無い');

const works = await getCollection('works');
const scenarios = await getCollection('scenarios');

type Resolved = { catch: string; href: string; badge?: string; no?: number };

const index = new Map<string, { catch: string; href: string }>();
for (const w of works) index.set(w.id, { catch: w.data.catch, href: `/works/${w.id}` });
for (const s of scenarios) index.set(s.id, { catch: s.data.catch, href: `/scenario/${s.id}` });

/** ref を解決する。見つからなければビルドを落とす（壊れたまま本番へ出さない） */
function resolve(h: (typeof issue.data.headlines)[number]): Resolved {
  if (h.collection === 'page') {
    return { catch: h.catch ?? h.ref, href: h.ref, badge: h.badge, no: h.no };
  }
  const found = index.get(h.ref);
  if (!found) {
    throw new Error(
      `vol01.md の headlines に未知の ref: "${h.ref}"。` +
        `src/content/${h.collection}/${h.ref}.md が要る`
    );
  }
  return { catch: h.catch ?? found.catch, href: found.href, badge: h.badge, no: h.no };
}

const slot = (name: string) =>
  issue.data.headlines.filter((h) => h.slot === name).map(resolve);

const lead = slot('lead');
const upper = slot('upper');
const side = slot('side');
const lower = slot('lower');
const strip = slot('strip');

const issued = issue.data.published;
const ym = `${issued.getFullYear()}.${String(issued.getMonth() + 1).padStart(2, '0')}`;
---

<Base title="表紙" cover>
  <div class="stage">
  <div class="cover">
    <div class="cover__rail">
      <span>{issue.data.vol}　{issue.data.label}　{ym}</span>
      <span class="cover__price">定価 ¥0</span>
    </div>

    <h1 class="cover__title">
      <span class="cover__title-jp">オギャヌンティウス十三世</span>
      <span class="cover__title-en">OGYANUNTIUS XIII</span>
    </h1>

    <div class="cover__body">
      <div class="cover__left">
        <p class="cover__theme">{issue.data.theme}</p>

        {lead.map((h) => (
          <a class="cover__lead" href={h.href}>
            {h.no && <i class="no">{String(h.no).padStart(2, '0')}</i>}
            {h.badge && <span class="label">{h.badge}</span>}
            <span class="cover__lead-text">{h.catch}</span>
          </a>
        ))}

        {lower.map((h) => (
          <a class="cover__small" href={h.href}>
            <span aria-hidden="true">▶</span> {h.catch}
          </a>
        ))}
      </div>

      <figure class="cover__visual">
        <img
          src={issue.data.mainVisual}
          alt={issue.data.mainVisualAlt}
          width="1200"
          height="1500"
          fetchpriority="high"
          style={`object-position:${issue.data.mainVisualFocus}`}
        />
      </figure>

      <div class="cover__right">
        {[...upper, ...side].map((h) => (
          <a class="cover__mid" href={h.href}>
            {h.no && <i class="no">{String(h.no).padStart(2, '0')}</i>}
            {h.badge && <span class="label">{h.badge}</span>}
            <span>{h.catch}</span>
          </a>
        ))}

        <ul class="cover__strips">
          {issue.data.strips.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>

    <div class="cover__foot">
      <a href="/contents" class="cover__contents">
        CONTENTS <span aria-hidden="true">→</span>
      </a>
      {strip.map((h) => (
        <a class="cover__small" href={h.href}>
          <span aria-hidden="true">▶</span> {h.catch}
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  /* 表紙だけはインパクト最優先（仕様書5章）。ここ以外へこの書き方を持ち出さない。

     誌面は「ビューポート」ではなく「一枚の縦長の面」。
     画面が横長でも誌面は縦長のまま、真ん中に一冊置いてあるように見せる。
     中の寸法はすべて cqw（誌面の幅基準）なので、面が伸び縮みしても構図は崩れない。 */

  .stage {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: clamp(10px, 2.2vh, 28px) clamp(10px, 2vw, 28px);
    background: var(--ground);
  }

  .cover {
    container-type: inline-size;
    position: relative;
    width: min(100%, calc((100svh - clamp(20px, 4.4vh, 56px)) * var(--page-ratio)));
    aspect-ratio: var(--page-ratio);
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 1.4cqw;
    padding: 0 3.4cqw 3cqw;
    background: var(--paper);
    box-shadow:
      0 1px 0 rgba(0, 0, 0, .18),
      0 18px 40px -14px rgba(0, 0, 0, .34);
    overflow: hidden;
  }

  .cover__rail {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-en);
    font-size: 1.55cqw;
    letter-spacing: .2em;
    padding: 2.6cqw 0 1.1cqw;
    border-bottom: 2px solid var(--rule);
  }
  .cover__price { color: var(--accent); font-weight: 700; }

  .cover__title { margin: 0; }
  .cover__title-jp {
    display: block;
    font-size: 8.6cqw;
    font-weight: 800;
    letter-spacing: -.045em;
    line-height: .98;
    white-space: nowrap;
  }
  .cover__title-en {
    display: block;
    font-family: var(--font-en);
    font-size: 1.5cqw;
    font-weight: 400;
    letter-spacing: .5em;
    padding-top: .6em;
  }

  .cover__body {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 1.2fr) minmax(0, .78fr);
    gap: 2.6cqw;
    align-items: stretch;
    min-height: 0;
  }

  .cover__left { display: flex; flex-direction: column; }

  .cover__theme {
    margin: 0 0 .55em;
    font-size: 6.8cqw;
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -.035em;
  }

  .cover__lead {
    display: block;
    text-decoration: none;
    font-size: 2.9cqw;
    font-weight: 700;
    line-height: 1.32;
    border-top: 1px solid var(--rule);
    padding-top: .5em;
    margin-bottom: .8em;
  }
  .cover__lead:hover .cover__lead-text,
  .cover__mid:hover span:last-child { text-decoration: underline; }

  .cover__mid {
    display: block;
    text-decoration: none;
    font-size: 2.15cqw;
    font-weight: 700;
    line-height: 1.42;
    border-top: 1px solid var(--rule);
    padding: .5em 0 .9em;
  }

  .cover__small {
    display: inline-block;
    text-decoration: none;
    font-size: 1.75cqw;
    font-weight: 700;
    margin-right: 1.6em;
  }
  .cover__small:hover { color: var(--accent); }

  /* 面の中で画像だけが縦に伸びる。投げ込む画像の縦横比が違っても構図は変わらない */
  .cover__visual { margin: 0; min-height: 0; }
  .cover__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .cover__strips {
    list-style: none;
    margin: .6em 0 0;
    padding: 0;
    font-size: 1.5cqw;
    line-height: 1.65;
    color: var(--ink-mid);
  }
  .cover__strips li::before { content: '▸ '; color: var(--accent); }

  .cover__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 1.4em;
    border-top: 2px solid var(--rule);
    padding-top: 1.2cqw;
  }
  .cover__contents {
    font-family: var(--font-en);
    font-size: 2cqw;
    font-weight: 700;
    letter-spacing: .2em;
    text-decoration: none;
    margin-right: auto;
  }
  .cover__contents:hover { color: var(--accent); }

  .no { font-size: .9em; }

  /* スマホでは一冊を置く見せ方をやめ、縦長の誌面そのものにする（仕様書19章）。
     コンセプトより操作性。ただし表紙のインパクトは落とさない。 */
  @media (max-width: 700px) {
    .stage { padding: 0; background: var(--paper); }
    .cover {
      width: 100%;
      aspect-ratio: auto;
      min-height: 100svh;
      box-shadow: none;
      padding: 0 var(--gut) var(--gut);
      gap: 3cqw;
    }
    .cover__body { grid-template-columns: 1fr; gap: 4cqw; }
    .cover__title-jp { font-size: 9cqw; }
    .cover__title-en { font-size: 2.4cqw; letter-spacing: .4em; }
    .cover__theme { font-size: 9.5cqw; }
    .cover__lead { font-size: 4.6cqw; }
    .cover__mid { font-size: 3.9cqw; }
    .cover__small { font-size: 3.2cqw; }
    .cover__strips { font-size: 2.9cqw; }
    .cover__contents { font-size: 3.4cqw; }
    .cover__rail { font-size: 2.6cqw; }
    .cover__visual { aspect-ratio: 4 / 5; }
  }
</style>
