---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { buildNewsLinker } from '../lib/newsLink';
import ThemeToggle from '../components/ThemeToggle.astro';

const issues = await getCollection('issues');
const issue = issues.find((i) => i.data.current) ?? issues[0];
if (!issue) throw new Error('src/content/issues/ に号が1つも無い');

const works = await getCollection('works');
const scenarios = await getCollection('scenarios');
/* コロコロ側の情報量はここから来る。装飾ではなく実データを載せる（仕様書4章・8章） */
const nowmaking = (await getCollection('nowmaking')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const news = (await getCollection('news')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
/* NEWS を押したら、その作品のページへ直接行く（以前は全部 /contents へ逃がしていた） */
const newsLink = await buildNewsLinker();

type Resolved = { catch: string; href: string; badge?: string; no?: number };

const index = new Map<string, { catch: string; href: string }>();
for (const w of works) index.set(w.id, { catch: w.data.catch, href: `/works/${w.id}` });
for (const s of scenarios) index.set(s.id, { catch: s.data.catch, href: `/scenario/${s.id}` });

/** ref を解決する。見つからなければビルドを落とす（壊れたまま本番へ出さない） */
function resolve(h: (typeof issue.data.headlines)[number]): Resolved {
  if (h.collection === 'page') {
    return { catch: h.catch ?? h.ref, href: h.ref, badge: h.badge, no: h.no };
  }
  const found = index.get(h.ref);
  if (!found) {
    throw new Error(
      `vol01.md の headlines に未知の ref: "${h.ref}"。` +
        `src/content/${h.collection}/${h.ref}.md が要る`
    );
  }
  return { catch: h.catch ?? found.catch, href: found.href, badge: h.badge, no: h.no };
}

const slot = (name: string) =>
  issue.data.headlines.filter((h) => h.slot === name).map(resolve);

const lead = slot('lead');
const upper = slot('upper');
const side = slot('side');
const lower = slot('lower');
const strip = slot('strip');

const issued = issue.data.published;
const md = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const featureCount = works.length + scenarios.length;
const ym = `${issued.getFullYear()}.${String(issued.getMonth() + 1).padStart(2, '0')}`;
/** 一冊の上に刷る号表記。ゼロ埋めしない（「2026年09月号」にしない） */
const issueLabel = `${issued.getFullYear()}年${issued.getMonth() + 1}月号`;
---

<Base title="表紙" cover>
  <div class="cover">
    <div class="cover__rail">
      <span>{issue.data.vol}　{issue.data.label}　{ym}</span>
      {/* ⚠️ 定価とカウンタは**1つの塊**にする。
             rail は中身を左右へ散らすので、別々に置くと定価が真ん中へ押し出される。 */}
      <span class="cover__railright">
        <span class="cover__price">定価 ¥0</span>
        {/* 表紙に来た人の数。D1が繋がっていないときは出ない */}
        <span class="cover__views" id="viewBox" hidden>
          本日 <b id="viewToday"></b>　累計 <b id="viewTotal"></b> <span class="cover__viewsUnit">view</span>
        </span>
        <ThemeToggle />
      </span>
    </div>

    <h1 class="cover__title">
      <span class="cover__title-jp">オギャヌンティウス十三世</span>
      <span class="cover__title-en">OGYANUNTIUS XIII</span>
    </h1>

    <div class="cover__body">
      <div class="cover__left">
        <p class="cover__theme">
          {/* 改行位置は vol01.md 側で決める。折り返し任せにしない */}
          {issue.data.theme.split('\n').map((line) => <span>{line}</span>)}
        </p>

        {lower.map((h) => (
          <a class="cover__small" href={h.href}>
            <span aria-hidden="true">▶</span> {h.catch}
          </a>
        ))}

        {lead.map((h) => (
          <a class="cover__lead" href={h.href}>
            {h.no && <i class="no">{String(h.no).padStart(2, '0')}</i>}
            <span class="cover__lead-text">{h.catch}</span>
            {h.badge && <span class="label">{h.badge}</span>}
          </a>
        ))}

        <section class="block">
          <h2 class="block__ttl">NOW MAKING<span class="block__note">この人、また何か作っている</span></h2>
          <ul class="block__list">
            {nowmaking.map((n, i) => (
              <li>
                <a class="block__row" href={n.data.ref ? `/works/${n.data.ref}` : '/contents'}>
                  <span class="block__tag">制作中</span>
                  <i class="no">{String(i + 1).padStart(2, '0')}</i>
                  <span class="block__body">
                    <b>{n.data.title}</b>
                    <span class="block__sub">{n.data.catch}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <figure class="cover__visual">
        {/* 中央に置く一冊。雑誌らしさはここで作る。周りの誌面レイアウトは触らない */}
        <a class="mag-link" href="/about" aria-label="オギャヌンティウス十三世とは？">
        <div class={`mag mag--${issue.data.coverInk}`}>
          <img
            src={issue.data.mainVisual}
            alt={issue.data.mainVisualAlt}
            width="1200"
            height="1500"
            fetchpriority="high"
            style={`object-position:${issue.data.mainVisualFocus}`}
          />
          {/* 誌面側に同じ情報があるので、読み上げでは飛ばす（仕様書20章） */}
          <div class="mag__dress" aria-hidden="true">
            <p class="mag__issue">
              <span>{issueLabel}</span>
              <span class="mag__sep">|</span>
              <span>{issue.data.vol}</span>
              <span class="mag__sep">|</span>
              <span>{issue.data.label}</span>
            </p>

            <p class="mag__masthead">
              <span class="mag__masthead-jp">{issue.data.magTitleJp}</span>
              <span class="mag__masthead-en">{issue.data.magTitleEn}</span>
            </p>

            <ul class="mag__lines">
              {issue.data.coverLines.map((line) => <li>{line}</li>)}
            </ul>

            <div class="mag__bottom">
              <span class="mag__price">¥0</span>
              <span class="mag__pub">発行 オギャヌンティウス十三世</span>
              <span class="mag__barcode"></span>
            </div>
          </div>
          <span class="mag__spine" aria-hidden="true"></span>

          {issue.data.coverNote && (
            <div class="mag__obi">
              <p class="mag__obi-text"><b>表紙</b>{issue.data.coverNote}</p>
              <p class="mag__obi-cta">オギャヌンティウス十三世とは？<span aria-hidden="true"> →</span></p>
            </div>
          )}
        </div>
        </a>
      </figure>

      <div class="cover__right">
        {[...upper, ...side].map((h) => (
          <a class="cover__mid" href={h.href}>
            {h.no && <i class="no">{String(h.no).padStart(2, '0')}</i>}
            <span>{h.catch}</span>
            {h.badge && <span class="label">{h.badge}</span>}
          </a>
        ))}

        <section class="block">
          <h2 class="block__ttl">今月の制作物<span class="block__note">NEWS</span></h2>
          <ul class="block__list">
            {news.map((n) => (
              <li>
                <a class="block__row block__row--news" href={newsLink(n).href}>
                  <time class="block__date">{md(n.data.date)}</time>
                  <span class="block__body">{n.data.title}</span>
                  <span class="block__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <ul class="cover__strips">
          {issue.data.strips.map((s) => <li>{s}</li>)}
        </ul>

        {/* 右下の余白に座るタッコ。押すとデスクタッコの紹介へ */}
        <a class="cover__tako" href="/works/desk-takko" aria-label="デスクタッコの紹介へ">
          <img
            src="/images/about/tako-icon.webp"
            alt=""
            width="288"
            height="204"
            loading="eager"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>

    <div class="cover__foot">
      <a href="/contents" class="cover__contents">
        CONTENTS <span aria-hidden="true">→</span>
      </a>
      {/* 誌面の外にある行き先。**本棚をやめて素のリンクに戻した**
          （本人・2026-08-29「普通に、創刊号→ 卓報告→ みたいな感じで実装しよう」） */}
      <a href="/contents" class="cover__jump">創刊号 <span aria-hidden="true">→</span></a>
      <a href="/sessions" class="cover__jump">卓報告 <span aria-hidden="true">→</span></a>
      {/* 紹介してくれる人向け。**素材と掲載条件が置いてある公開ページ**（関係者限定ではない） */}
      <a href="/press" class="cover__jump cover__jump--last">プレスキット <span aria-hidden="true">→</span></a>
      {strip.map((h) => (
        <a class="cover__small" href={h.href}>
          <span aria-hidden="true">▶</span> {h.catch}
        </a>
      ))}
      <span class="cover__stamp">特集{featureCount}本</span>
      <span class="cover__stamp">全部無料</span>
      <span class="cover__stamp cover__stamp--next">次号 VOL.02 準備中</span>
    </div>
  </div>
</Base>

<style>
  /* 表紙だけはインパクト最優先（仕様書5章）。ここ以外へこの書き方を持ち出さない。 */
  .cover {
    min-height: 100svh;
    display: grid;
    /* rail / 誌名 / 誌面 / フット。本棚はフットの中に入っているので行は増やさない */
    grid-template-rows: auto auto 1fr auto;
    padding: 0 var(--gut) calc(var(--gut) * 0.6);
    --cover-gap: clamp(10px, 1.6vw, 22px);
    gap: var(--cover-gap);
  }

  .cover__rail {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-en);
    font-size: clamp(10px, 1.1vw, 12px);
    letter-spacing: 0.2em;
    padding: 12px 0 8px;
    border-bottom: 2px solid var(--rule);
  }
  .cover__price { color: var(--accent); font-weight: 700; }
  .cover__railright {
    display: inline-flex; align-items: baseline; gap: .4em 1.1em;
    /* 定価・カウンタ・昼夜ボタンの3つが並ぶ。狭い端末では折り返させる */
    flex-wrap: wrap; justify-content: flex-end;
  }
  /* 定価の右。誌面の情報なので、主張させず罫の一部として置く */
  .cover__views { color: var(--ink-mid, #7a7a86); letter-spacing: .04em; white-space: nowrap; }
  .cover__views b { font-family: var(--font-en); font-weight: 700; color: var(--ink); }
  .cover__viewsUnit { font-family: var(--font-en); letter-spacing: .1em; }

  .cover__title { margin: 0; }
  .cover__title-jp {
    display: block;
    font-size: clamp(1.9rem, 7.8vw, 7.2rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }
  .cover__title-en {
    display: block;
    font-family: var(--font-en);
    font-size: clamp(9px, 1.25vw, 15px);
    font-weight: 400;
    letter-spacing: 0.52em;
    padding-top: 0.5em;
  }

  .cover__body {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2.4vw, 34px);
    align-items: start;
    min-height: 0;
  }

  .cover__theme {
    margin: 0 0 0.5em;
    font-size: clamp(2rem, 6.4vw, 4.6rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  /* 1行＝1span。折り返し任せにせず、vol01.md の改行どおりに折る */
  .cover__theme span { display: block; }

  .cover__lead {
    display: block;
    text-decoration: none;
    font-size: clamp(1.05rem, 2.1vw, 1.7rem);
    font-weight: 700;
    line-height: 1.35;
    border-top: 1px solid var(--rule);
    padding-top: 0.5em;
    margin-bottom: 0.9em;
  }
  .cover__lead-text { display: inline; }
  /* ⚠️ ここを span:last-child で狙わないこと。
     バッジを見出しのうしろへ移した時点で、last-child が NEW バッジになり、
     **タイトルではなくバッジに下線が付く。** 実際にこれを踏みかけた（2026-08-29）。 */
  .cover__lead:hover .cover__lead-text,
  .cover__mid:hover span:not(.label) { text-decoration: underline; }

  /* バッジは見出しの**うしろ**に置く（本人・2026-08-29）。
     文字と接するので、間隔はここで足す。.label 自体は他所でも使うので触らない */
  .cover__lead .label,
  .cover__mid .label { margin-left: .5em; }

  .cover__mid {
    display: block;
    text-decoration: none;
    font-size: clamp(0.95rem, 1.35vw, 1.15rem);
    font-weight: 700;
    line-height: 1.45;
    border-top: 1px solid var(--rule);
    padding: 0.5em 0 0.9em;
  }

  .cover__left .cover__small { margin-bottom: 1.1em; }

  .cover__small {
    display: inline-block;
    text-decoration: none;
    font-size: clamp(0.8rem, 1vw, 0.9rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    margin-right: 1.4em;
  }
  .cover__small:hover { color: var(--accent); }

  /* --- 中央の一冊 -------------------------------------------
     「画像＋文字」ではなく、**物体としての雑誌**にする。
     効いているのは (1)誌名がサイト名と別 (2)表紙に刷られた見出し
     (3)背表紙の陰 (4)紙の厚みぶんの影 の4つ。
     寸法は cqw（この一冊の幅基準）。誌面側の vw とは独立している。 */
  .cover__visual {
    margin: 0;
    min-height: 0;
    display: flex;
    justify-content: center;
  }

  /* 一冊まるごとがリンク。押すと「オギャヌンティウス十三世とは？」へ */
  .mag-link {
    display: flex;
    justify-content: center;
    width: 100%;
    text-decoration: none;
    color: inherit;
  }
  .mag-link:focus-visible { outline-offset: 6px; }

  .mag {
    /* ⚠️ **ここは印刷された物体。サイトの明暗（昼／夜）に連動させない。**
       トークンをこの中だけ刷り色へ固定しているので、子要素すべてが昼の値を使う。
       .mag--dark / .mag--light は**画像の明るさに対する刷り色**の話で、
       サイトのダークモードとは無関係。名前が似ているだけ（4.4節）。 */
    --accent: #e0301e;
    --accent-ink: #ffffff;
    --paper-2: #f4f2ed;

    container-type: inline-size;
    transition: transform 160ms ease, box-shadow 160ms ease;
    position: relative;
    width: 100%;
    aspect-ratio: var(--mag-ratio);
    overflow: hidden;
    background: var(--paper-2);
    /* 右下へ落とす。左は背表紙なので影を出さない＝綴じられて見える */
    box-shadow:
      0 0 0 1px var(--mag-ring),
      2px 3px 0 rgba(0, 0, 0, .06),
      14px 20px 40px -14px var(--mag-drop);
  }

  .mag > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 背表紙の折り。ここが物体らしさの大半を作っている */
  .mag__spine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 4.2cqw;
    background:
      linear-gradient(90deg,
        rgba(0, 0, 0, .26) 0%,
        rgba(0, 0, 0, .10) 38%,
        rgba(255, 255, 255, .28) 76%,
        rgba(0, 0, 0, .16) 100%);
  }

  .mag__dress {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 5cqw 5cqw 2.6cqw 8cqw;   /* 左は背表紙ぶん広げる */
    color: var(--mag-ink);
    text-shadow: var(--mag-shadow);
  }
  .mag__dress::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--mag-scrim);
    pointer-events: none;
  }
  .mag__dress > * { position: relative; }

  /* スクリムは**最下部だけ**。ここを広げると被写体の顔にモヤがかかる。
     見出しの可読性は全面を白ませるのではなく、見出し自身の白帯（.mag__lines li）で取る。 */
  .mag--dark { --mag-ink: #101010; --mag-plate: rgba(255,255,255,.88);
    --mag-shadow: none;
    --mag-scrim: linear-gradient(180deg, rgba(255,255,255,0) 88%, rgba(255,255,255,.78) 100%); }
  .mag--light { --mag-ink: #ffffff; --mag-plate: rgba(0,0,0,.62);
    --mag-shadow: 0 1px 3px rgba(0,0,0,.7);
    --mag-scrim: linear-gradient(180deg, rgba(0,0,0,0) 88%, rgba(0,0,0,.7) 100%); }

  .mag__issue {
    margin: 0;
    display: flex;
    gap: .7em;
    font-family: var(--font-en);
    font-size: 2.5cqw;
    font-weight: 700;
    letter-spacing: .14em;
  }
  .mag__sep { opacity: .45; }

  /* 誌名。サイト名ではない。
     ファッション誌の組み：ディドー系セリフ・大文字・字間広め・罫は極細。
     太いゴシック＋極太罫は新聞やコロコロの組みで、遠目の第一印象が変わる。 */
  .mag__masthead {
    margin: .55em 0 0;
    white-space: nowrap;
    padding-bottom: .28em;
    border-bottom: 1px solid var(--mag-ink);
    line-height: .88;
  }
  .mag__masthead-jp {
    display: block;
    margin-bottom: .9em;
    font-size: 2.4cqw;
    font-weight: 400;
    letter-spacing: .62em;
    text-indent: .62em;   /* 字間の右余りを相殺して、左を罫と揃える */
  }
  .mag__masthead-en {
    display: block;
    font-family: var(--font-display);
    font-size: 16.2cqw;
    font-weight: 500;
    font-style: normal;
    letter-spacing: .03em;
    text-indent: .03em;
    text-transform: uppercase;
  }

  /* 表紙に刷られた見出し。これが無いと雑誌に見えない */
  .mag__lines {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .38em;
    font-size: 3.1cqw;
    font-weight: 700;
    line-height: 1.3;
  }
  .mag__lines { transition: opacity 150ms ease; }
  .mag-link:hover .mag__lines,
  .mag-link:focus-visible .mag__lines { opacity: 0; }

  .mag__lines li {
    position: relative;
    padding: .16em .5em .16em 1.9em;
    background: var(--mag-plate);
  }
  .mag__lines li::before {
    content: '';
    position: absolute;
    left: .5em;
    top: .68em;
    width: 1em;
    height: .22em;
    background: var(--accent);
  }

  .mag__bottom {
    margin-top: .5em;
    text-shadow: 0 1px 2px rgba(255, 255, 255, .55);
    display: flex;
    align-items: flex-end;
    gap: .9em;
    font-family: var(--font-en);
    font-size: 2.7cqw;
    font-weight: 700;
    letter-spacing: .1em;
  }
  .mag__pub {
    margin-right: auto;
    font-family: var(--font-jp);
    font-size: 2.1cqw;
    font-weight: 400;
    letter-spacing: .06em;
    opacity: .7;
  }
  .mag__price { font-size: 3.4cqw; }

  /* 本の帯。カーソルを置くと下から上がってくる（仕様書10章 演出は短く） */
  .mag__obi {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 4cqw 5cqw 4cqw 8cqw;
    background: rgba(16, 16, 16, .92);
    color: #fff;
    transform: translateY(101%);
    transition: transform 190ms cubic-bezier(.4, 0, .2, 1);
  }
  .mag__obi p { margin: 0; }
  .mag__obi-text {
    font-size: 3cqw;
    line-height: 1.5;
  }
  .mag__obi-text b {
    display: inline-block;
    margin-right: .7em;
    padding: 0 .45em;
    background: var(--accent);
    font-size: .86em;
    letter-spacing: .1em;
  }
  .mag__obi-cta {
    margin-top: .7em;
    font-size: 2.7cqw;
    font-weight: 700;
    letter-spacing: .04em;
    color: #fff;
    text-decoration: underline;
    text-underline-offset: .3em;
  }

  .mag-link:hover .mag,
  .mag-link:focus-visible .mag {
    transform: translateY(-5px);
    box-shadow:
      0 0 0 1px var(--mag-ring),
      2px 3px 0 rgba(0, 0, 0, .06),
      18px 28px 50px -14px var(--mag-drop);
  }
  .mag-link:hover .mag__obi,
  .mag-link:focus-visible .mag__obi { transform: translateY(0); }

  /* 触れない端末には最初から出しておく（ホバーが無いと存在に気付けない）。
     position は absolute のまま。static にすると帯が本の上端へ飛ぶ */
  @media (hover: none) {
    .mag__obi { transform: translateY(0); }
    .mag-link:hover .mag { transform: none; box-shadow: inherit; }
  }

  /* バーコード。背景の縞で描くので画像は増えない */
  .mag__barcode {
    width: 22cqw;
    height: 6cqw;
    background-image: repeating-linear-gradient(90deg,
